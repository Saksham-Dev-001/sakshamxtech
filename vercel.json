{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blogs/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Discordbot|TelegramBot|SkypeUriPreview|Pinterestbot).*"
        }
      ],
      "destination": "/api/og?type=blog&slug=:slug"
    },
    {
      "source": "/arcade/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Discordbot|TelegramBot|SkypeUriPreview|Pinterestbot).*"
        }
      ],
      "destination": "/api/og?type=arcade&slug=:slug"
    },
    {
      "source": "/unstop/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Discordbot|TelegramBot|SkypeUriPreview|Pinterestbot).*"
        }
      ],
      "destination": "/api/og?type=unstop&slug=:slug"
    },
    {
      "source": "/c-academy/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Discordbot|TelegramBot|SkypeUriPreview|Pinterestbot).*"
        }
      ],
      "destination": "/api/og?type=c-lesson&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/ads-txt"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
