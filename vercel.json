{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blogs/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|TelegramBot|telegram|Twitterbot|twitter|facebookexternalhit|LinkedInBot|linkedin|Discordbot|discord|Slackbot|slack|Applebot|apple|SkypeUriPreview|skype|Pinterest|Googlebot).*"
        }
      ],
      "destination": "/api/og?type=blog&slug=:slug"
    },
    {
      "source": "/arcade/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|TelegramBot|telegram|Twitterbot|twitter|facebookexternalhit|LinkedInBot|linkedin|Discordbot|discord|Slackbot|slack|Applebot|apple|SkypeUriPreview|skype|Pinterest|Googlebot).*"
        }
      ],
      "destination": "/api/og?type=arcade&slug=:slug"
    },
    {
      "source": "/unstop/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|TelegramBot|telegram|Twitterbot|twitter|facebookexternalhit|LinkedInBot|linkedin|Discordbot|discord|Slackbot|slack|Applebot|apple|SkypeUriPreview|skype|Pinterest|Googlebot).*"
        }
      ],
      "destination": "/api/og?type=unstop&slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
